<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NothingShell</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\tools\NothingShell.psm1" Link="tools\NothingShell.psm1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\NothingShell.Agent.ps1" Link="tools\NothingShell.Agent.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\connectors\*.json" Link="connectors\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sdk\django\**\*.py;..\..\sdk\django\pyproject.toml;..\..\sdk\django\README.md" Exclude="..\..\sdk\django\**\__pycache__\**" Link="sdk\django\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NothingShell.Core\NothingShell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <!-- Il backend di LLamaSharp porta le librerie di ogni sistema (~100 MB): qui servono solo quelle di Windows. -->
  <Target Name="RemoveForeignRuntimes" AfterTargets="Build">
    <ItemGroup>
      <ForeignRuntime Include="$(OutDir)runtimes\linux*\**\*;$(OutDir)runtimes\osx*\**\*" />
    </ItemGroup>
    <Delete Files="@(ForeignRuntime)" />
  </Target>

</Project>
